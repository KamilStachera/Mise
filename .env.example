# Copy this file to .env and adjust as needed:  cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL (the `db` service)
# ---------------------------------------------------------------------------
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise_dev_password
POSTGRES_DB=mise

# Connection string used by the API container (host `db` is the compose service)
ConnectionStrings__Default=Host=db;Port=5432;Database=mise;Username=mise;Password=mise_dev_password

# ---------------------------------------------------------------------------
# Agent integration (Codex / Claude Code)
#
# HOST_CONTEXT_DIR: absolute path of ./context on THIS machine, e.g.
#   E:\Ntropy\Repos\CukBuk\context
# Optional — it only lets the app render ready-made agent prompts with the real
# path (Profile -> "Połącz agenta"). If empty, the UI will ask for the path.
#
# PUBLIC_API_BASE: how agents on this machine reach the API. Default is fine
# unless you changed the published port.
# ---------------------------------------------------------------------------
HOST_CONTEXT_DIR=
PUBLIC_API_BASE=http://localhost:5080/api

# ---------------------------------------------------------------------------
# Access control (README: "Going public").
#
# Anonymous visitors get READ-ONLY access; every write needs one of:
#   - a logged-in Google account whose email is on AUTH_ALLOWED_EMAILS, or
#   - the X-Api-Key header equal to MISE_API_KEY (agents / MCP server).
#
# MISE_API_KEY: any long random secret (e.g. `openssl rand -hex 32`).
#   Empty = key auth disabled; agents can't write.
# AUTH_ALLOWED_EMAILS: comma-separated Google account emails allowed to edit.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: OAuth 2.0 Web client from
#   https://console.cloud.google.com/apis/credentials with redirect URI
#   https://<your-domain>/api/auth/google-callback (plus
#   http://localhost:8080/api/auth/google-callback for local testing).
#   Empty = Google login disabled (the app still runs).
# AUTH_DEV_BYPASS: true = every request is treated as logged-in. LOCAL DEV
#   ONLY — never on a machine exposed to the internet.
# ---------------------------------------------------------------------------
MISE_API_KEY=
AUTH_ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_DEV_BYPASS=true

# ---------------------------------------------------------------------------
# Public exposure via Cloudflare Tunnel (compose profile "public"):
#   docker compose --profile public up -d --build
# TUNNEL_TOKEN: from Cloudflare Zero Trust -> Networks -> Tunnels (ingress:
#   https://<your-domain> -> http://web:80). When going public also set
#   PUBLIC_API_BASE=https://<your-domain>/api and AUTH_DEV_BYPASS=false.
# WEB_BIND: host address:port nginx is published on. Default 8080 (all
#   interfaces, LAN-friendly). On a public VPS set 127.0.0.1:8080 so the only
#   way in is the tunnel.
# ---------------------------------------------------------------------------
TUNNEL_TOKEN=
WEB_BIND=8080

# ---------------------------------------------------------------------------
# Optional in-app "Sous" chat.
#
# The PRIMARY AI path is the exported ./context folder opened with Codex
# ("Sign in with ChatGPT") or Claude Code — that needs nothing here.
#
# Leave AI_PROVIDER empty to keep the in-app chat panel disabled.
# Set it to "openai" or "ollama" to turn the in-app chat on.
# ---------------------------------------------------------------------------
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
