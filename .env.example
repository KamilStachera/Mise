# Copy this file to .env and adjust as needed:  cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL (the `db` service)
# ---------------------------------------------------------------------------
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise_dev_password
POSTGRES_DB=mise

# Connection string used by the API container (host `db` is the compose service)
ConnectionStrings__Default=Host=db;Port=5432;Database=mise;Username=mise;Password=mise_dev_password

# ---------------------------------------------------------------------------
# Agent integration (Codex / Claude Code)
#
# HOST_CONTEXT_DIR: absolute path of ./context on THIS machine, e.g.
#   E:\Ntropy\Repos\CukBuk\context
# Optional — it only lets the app render ready-made agent prompts with the real
# path (Profile -> "Połącz agenta"). If empty, the UI will ask for the path.
#
# PUBLIC_API_BASE: how agents on this machine reach the API. Default is fine
# unless you changed the published port.
# ---------------------------------------------------------------------------
HOST_CONTEXT_DIR=
PUBLIC_API_BASE=http://localhost:5080/api

# ---------------------------------------------------------------------------
# Households and access (README: "Households and access").
#
# Every household has its own recipes, pantry, shopping, plan and people.
# Anyone may sign in with Google; an account that belongs to no household
# sees the invite-code screen. Codes: Profil → Domownicy (join my household)
# or, for admins, Profil → Gospodarstwa (a new household with starter recipes).
# Agents use personal API keys (Profil → Połącz agenta).
#
# ADMIN_EMAILS: comma-separated Google emails that may create households and
#   switch Sous on per household (Sous runs on the owner's ChatGPT plan). An
#   admin email that belongs to nobody yet joins household 1 on boot.
# PUBLIC_HOUSEHOLD_ID: household anonymous visitors may browse read-only
#   (e.g. 1). Empty = anonymous visitors only see the sign-in screen.
# MISE_API_KEY: internal key the sous container uses to call the API (any
#   long random secret, e.g. `openssl rand -hex 32`). It must name a person
#   (X-Person); it is not for agents any more.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: OAuth 2.0 Web client from
#   https://console.cloud.google.com/apis/credentials with redirect URI
#   https://<your-domain>/api/auth/google-callback (plus
#   http://localhost:8080/api/auth/google-callback for local testing).
#   Empty = Google login disabled (the app still runs).
#   Google's consent screen in "Testing" mode only lets listed test users in —
#   add each friend there, or publish the app.
# AUTH_DEV_BYPASS: true = every request is treated as logged-in (as the first
#   person; X-Person may pick anyone). LOCAL DEV ONLY — never on a machine
#   exposed to the internet.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=
PUBLIC_HOUSEHOLD_ID=
MISE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_DEV_BYPASS=true

# Legacy (single-household) settings — read once on boot to link Google
# accounts to household 1, then no longer needed:
#   DIARY_PEOPLE=Name:google-email,…  (order = existing person ids)
#   AUTH_ALLOWED_EMAILS=…             (each unlinked email becomes a new person in household 1)
DIARY_PEOPLE=
AUTH_ALLOWED_EMAILS=

# ---------------------------------------------------------------------------
# Public exposure via Cloudflare Tunnel (compose profile "public"):
#   docker compose --profile public up -d --build
# TUNNEL_TOKEN: from Cloudflare Zero Trust -> Networks -> Tunnels (ingress:
#   https://<your-domain> -> http://web:80). When going public also set
#   PUBLIC_API_BASE=https://<your-domain>/api and AUTH_DEV_BYPASS=false.
# WEB_BIND: host address:port nginx is published on. Default 8080 (all
#   interfaces, LAN-friendly). On a public VPS set 127.0.0.1:8080 so the only
#   way in is the tunnel.
# ---------------------------------------------------------------------------
TUNNEL_TOKEN=
WEB_BIND=8080

# ---------------------------------------------------------------------------
# Optional in-app "Sous" chat.
#
# The PRIMARY AI path is the exported ./context folder opened with Codex
# ("Sign in with ChatGPT") or Claude Code — that needs nothing here.
#
# Leave AI_PROVIDER empty to keep the in-app chat panel disabled.
# Set it to "codex", "openai" or "ollama" to turn the in-app chat on.
#
# codex: the `sous` container runs Codex signed in with a ChatGPT plan (no API
#   billing). It reads ./context and writes through the pichci MCP tools, as the
#   signed-in person. One-time login on the server:
#     docker compose exec sous codex login --device-auth
#   (enable device-code login in ChatGPT → Settings → Security first).
#   SOUS_MODEL: empty = Codex default. SOUS_REASONING: minimal/low/medium/high.
# ---------------------------------------------------------------------------
AI_PROVIDER=
SOUS_MODEL=
SOUS_REASONING=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
