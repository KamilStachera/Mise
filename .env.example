# Copy this file to .env and adjust as needed:  cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL (the `db` service)
# ---------------------------------------------------------------------------
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise_dev_password
POSTGRES_DB=mise

# Connection string used by the API container (host `db` is the compose service)
ConnectionStrings__Default=Host=db;Port=5432;Database=mise;Username=mise;Password=mise_dev_password

# ---------------------------------------------------------------------------
# Agent integration (Codex / Claude Code)
#
# HOST_CONTEXT_DIR: absolute path of ./context on THIS machine, e.g.
#   E:\Ntropy\Repos\CukBuk\context
# Optional — it only lets the app render ready-made agent prompts with the real
# path (Profile -> "Połącz agenta"). If empty, the UI will ask for the path.
#
# PUBLIC_API_BASE: how agents on this machine reach the API. Default is fine
# unless you changed the published port.
# ---------------------------------------------------------------------------
HOST_CONTEXT_DIR=
PUBLIC_API_BASE=http://localhost:5080/api

# ---------------------------------------------------------------------------
# Optional in-app "Sous" chat.
#
# The PRIMARY AI path is the exported ./context folder opened with Codex
# ("Sign in with ChatGPT") or Claude Code — that needs nothing here.
#
# Leave AI_PROVIDER empty to keep the in-app chat panel disabled.
# Set it to "openai" or "ollama" to turn the in-app chat on.
# ---------------------------------------------------------------------------
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
